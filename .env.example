# Any OpenAI-compatible chat-completions endpoint (OpenAI, Groq, OpenRouter, Ollama, vLLM...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# SQLite by default. For Postgres: postgresql+psycopg://policylens:policylens@localhost:5432/policylens
DATABASE_URL=sqlite:///./policylens.db

# Fields below this confidence are flagged "needs human review".
REVIEW_THRESHOLD=0.7

# --- Rate limits on the one endpoint that spends the LLM key (see README, "Protecting the LLM key") ---
# Extractions per client IP per hour, and across everyone per rolling 24 hours (your spend ceiling).
EXTRACTIONS_PER_HOUR=5
LLM_DAILY_LIMIT=100
# Set to 1 only when running behind your own reverse proxy, so the client IP is read correctly.
TRUST_PROXY=

# --- Accounts (optional). Without these the site works as before, signed out. ---
# Clerk publishable key (public by design). The API reads CLERK_PUBLISHABLE_KEY; the UI build
# reads VITE_CLERK_PUBLISHABLE_KEY. Same value in both.
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# MongoDB for saved policies. Empty = SQL via DATABASE_URL (SQLite by default).
MONGODB_URI=
MONGODB_DB=policylens
# Public address of the site, for sitemap.xml and robots.txt. Empty = the address each request came in on.
PUBLIC_URL=

# --- Analytics (optional, PostHog). Both empty = nothing is sent. The key is a public project token. ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
